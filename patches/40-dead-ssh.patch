+static time_t monotonic_seconds(void)
+{
+	struct timespec ts;
+
+	clock_gettime(CLOCK_MONOTONIC, &ts);
+	return ts.tv_sec;
+}
+
+/*
+ * Wait until the server sends something. Give up when requests have been
+ * pending for sshfs.reply_timeout seconds without a single byte arriving.
+ * An idle connection never times out; ssh keepalives take care of that.
+ *
+ * This is the last line of defence against an ssh that neither delivers
+ * replies nor exits: without it every file system operation waits forever
+ * (and Explorer with it), because sshfs only notices a dead connection
+ * when ssh closes its end of the socket pair.
+ *
+ * req_count is read without sshfs.lock, since that lock is held while a
+ * reconnect runs sftp_init.
+ */
+static int wait_for_reply(struct conn *conn)
+{
+	struct pollfd fds;
+	time_t start = monotonic_seconds();
+	int res;
+
+	while (1) {
+		fds.fd = conn->rfd;
+		fds.events = POLLIN;
+		fds.revents = 0;
+		res = poll(&fds, 1, 1000);
+		if (res > 0)
+			return 0;
+		if (res == -1) {
+			if (errno == EINTR)
+				continue;
+			perror("poll");
+			return -1;
+		}
+		if (__atomic_load_n(&conn->req_count, __ATOMIC_RELAXED) == 0) {
+			start = monotonic_seconds();
+			continue;
+		}
+		if (monotonic_seconds() - start >= (time_t) sshfs.reply_timeout) {
+			fprintf(stderr, "no reply from server for %u seconds, "
+				"dropping connection\n", sshfs.reply_timeout);
+			return -1;
+		}
+	}
+}
