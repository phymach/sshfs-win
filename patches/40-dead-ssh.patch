+/*
+ * Make sure the ssh of a dead connection is gone. It normally exits by
+ * itself once the link drops, but if it hangs instead (e.g. while closing
+ * its network socket) it would keep running forever, and a writer blocked
+ * on the full socket pair would never return. Killing it also unblocks
+ * that writer.
+ */
+static void kill_ssh(struct conn *conn)
+{
+	pid_t pid = conn->ssh_pid;
+	pid_t res;
+	int i;
+
+	if (pid <= 0)
+		return;
+	conn->ssh_pid = -1;
+
+	/* not SIGTERM: ssh's own exit path is what may be stuck */
+	kill(pid, SIGKILL);
+	for (i = 0; i < 200; i++) {
+		if (i == 100) {
+			fprintf(stderr, "ssh (pid %d) ignores SIGKILL\n",
+				(int) pid);
+#ifdef __CYGWIN__
+			terminate_win_process(pid);
+#endif
+		}
+		res = waitpid(pid, NULL, WNOHANG);
+		if (res == pid || (res == -1 && errno != EINTR))
+			return;
+		usleep(10000);
+	}
+	fprintf(stderr, "failed to reap ssh (pid %d)\n", (int) pid);
+}
+
 static void close_conn(struct conn *conn)
 {
+	kill_ssh(conn);
 	close(conn->rfd);
 	if (conn->rfd != conn->wfd)
 		close(conn->wfd);
