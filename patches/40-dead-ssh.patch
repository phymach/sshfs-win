+#ifdef __CYGWIN__
+/*
+ * Last resort for kill_ssh(): a Cygwin process handles SIGKILL in its own
+ * signal thread, so one that is wedged inside a Windows call may not die.
+ * TerminateProcess always works. Kept at the end of the file so that the
+ * Windows headers cannot clash with anything above.
+ */
+#include <windows.h>
+#include <sys/cygwin.h>
+
+static int terminate_win_process(pid_t pid)
+{
+	DWORD winpid;
+	HANDLE h;
+	BOOL ok;
+
+	winpid = (DWORD) cygwin_internal(CW_CYGWIN_PID_TO_WINPID, pid);
+	if (winpid == 0)
+		return -1;
+	h = OpenProcess(PROCESS_TERMINATE, FALSE, winpid);
+	if (h == NULL)
+		return -1;
+	ok = TerminateProcess(h, 255);
+	CloseHandle(h);
+	return ok ? 0 : -1;
+}
+#endif
